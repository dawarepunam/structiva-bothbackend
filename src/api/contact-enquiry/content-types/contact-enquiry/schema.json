{
  "kind": "collectionType",
  "collectionName": "contact_enquiries",
  "info": {
    "singularName": "contact-enquiry",
    "pluralName": "contact-enquiries",
    "displayName": "Contact Enquiry",
    "description": "Public website project inquiries and contact submittals"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "fullName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "companyName": {
      "type": "string"
    },
    "projectSector": {
      "type": "enumeration",
      "enum": [
        "Water Pipeline Infrastructure",
        "Solar Infrastructure",
        "Water Storage Tanks",
        "Heavy Fabrication",
        "General EPC / Industrial",
        "Other"
      ],
      "default": "Water Pipeline Infrastructure"
    },
    "location": {
      "type": "string"
    },
    "estimatedScope": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "New",
        "In Review",
        "Contacted",
        "Proposal Sent",
        "Archived"
      ],
      "default": "New"
    }
  }
}
